{
  "name": "brass-birmingham-room",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-28",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1101", "simple": { "limit": 8, "period": 60 } }],
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "CHAT_STATE", "id": "07ab79e2ccc34d53aefc8e3577352757" }],
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" }, { "name": "ARCHIVE", "class_name": "Archive" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }, { "tag": "v3", "new_sqlite_classes": ["Archive"] }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "bham.leisurecat.cloud", "custom_domain": true }]
}
